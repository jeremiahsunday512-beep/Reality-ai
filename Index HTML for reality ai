<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reality AI Agent</title>
<style>
body{margin:0;font-family:sans-serif;background:#0a0a0a;color:white;display:flex;flex-direction:column;height:100vh}
header{padding:15px;background:#111;border-bottom:1px solid #222;text-align:center;font-weight:bold;font-size:20px}
#chat{flex:1;overflow-y:auto;padding:15px}
.msg{margin:10px 0;padding:12px 15px;border-radius:15px;max-width:80%}
.user{background:#0066ff;margin-left:auto}
.ai{background:#1a1a1a}
#inputBox{display:flex;padding:15px;background:#111;gap:10px}
input{flex:1;padding:12px;border-radius:25px;border:none;background:#222;color:white;outline:none}
button{padding:12px 20px;border-radius:25px;border:none;background:#0066ff;color:white;font-weight:bold}
</style>
</head>
<body>
<header>🌍 REALITY AI AGENT</header>
<div id="chat">
<div class="msg ai">Hello! I am Reality AI Agent - Your own AI built by you! Ask me anything! 🔥</div>
</div>
<div id="inputBox">
<input id="input" placeholder="Ask Reality AI...">
<button onclick="send()">Send</button>
</div>
<script>
function send(){
let i=document.getElementById('input');
let c=document.getElementById('chat');
if(!i.value)return;
c.innerHTML+=`<div class="msg user">${i.value}</div>`;
let q=i.value.toLowerCase();
i.value='';
setTimeout(()=>{
let r="I am Reality AI! Your own AI Agent! You built me! 🔥";
if(q.includes("who are you"))r="I am Reality AI Agent - Built by YOU! Not Meta AI, na your own! You own me 100%!";
if(q.includes("hello")||q.includes("hi"))r="Hello boss! Welcome to Reality AI! How I fit help you today?";
if(q.includes("what can you do"))r="I fit answer questions, gist with you, help you code, write anything! I be your personal AI!";
c.innerHTML+=`<div class="msg ai">${r}</div>`;
c.scrollTop=c.scrollHeight;
},500);
}
document.getElementById('input').addEventListener('keypress',function(e){if(e.key==='Enter')send()});
</script>
</body>
</html>
